<?xml version="1.0" encoding="utf-8"?>
<!-- Same package/version/label as AndroidManifest.xml, minus every Xposed
     meta-data key. DuckDetector's LSPosedPackageProbe flags installed apps
     whose meta-data contains any key starting with "xposed"
     (xposedmodule/xposedminversion/xposeddescription/xposedscope/
     xposedsharedprefs). LSPosed's daemon resolves enabled modules purely via
     assets/xposed_init (ConfigManager.getModuleApkPath + ConfigFileManager.
     loadModule) and never re-checks meta-data, so this variant keeps loading
     once the module has been enabled with the bootstrap APK. Install it with
     `pm install -r` over the enabled module; keep both manifests' package,
     versionCode and versionName in sync (tests enforce this). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.satori.qq"
    android:versionCode="87"
    android:versionName="0.11.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="com.tencent.mobileqq" /></queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hasCode="true"
        android:extractNativeLibs="true">
        <provider android:name=".control.ControlProvider" android:authorities="com.satori.qq.control" android:exported="true" />
    </application>
</manifest>
