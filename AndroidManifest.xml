<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.satori.qq"
    android:versionCode="138"
    android:versionName="0.29.3">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="com.tencent.mobileqq" /></queries>
    <application
        android:forceQueryable="true"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:hasCode="true">
        <provider android:name=".control.ControlProvider" android:authorities="com.satori.qq.control" android:exported="true" />
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 快捷设置磁贴：单击切 Guard ON/OFF（关闭只暂停，不关 QQ）。 -->
        <service
            android:name=".ui.GuardTileService"
            android:exported="true"
            android:label="@string/guard_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 行动作：停止保活并关闭 QQ。 -->
        <service
            android:name=".ui.GuardStopTileService"
            android:exported="true"
            android:label="@string/guard_stop_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
