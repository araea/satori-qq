<?xml version="1.0" encoding="utf-8"?>
<!--
  知弦 Design Tokens · 尺度（间距 / 形状 / 字级 / 尺寸 / 动效 / 状态层 / 断点）

  深浅色共用这一份；颜色在 tokens.xml（values 与 values-night 两份）。
  界面代码经生成的 R 类读取，名字拼错会在编译期失败。组件如何组合这些值见 docs/DESIGN.md。

  单位：字号、行高用 sp（跟随系统字号，含 Android 14 起的非线性缩放）；其余尺寸用 dp；
  动效的弹簧参数用整数存（阻尼比 ×100、刚度原值），时长用毫秒。
-->
<resources>

    <!-- 间距：4dp 网格。2xs 只用于分段列表与连接按钮组的缝隙 -->
    <dimen name="md_space_2xs">2dp</dimen>
    <dimen name="md_space_xs">4dp</dimen>
    <dimen name="md_space_sm">8dp</dimen>
    <dimen name="md_space_md">12dp</dimen>
    <dimen name="md_space_lg">16dp</dimen>
    <dimen name="md_space_xl">24dp</dimen>
    <dimen name="md_space_2xl">32dp</dimen>
    <dimen name="md_space_3xl">48dp</dimen>

    <!-- 形状：M3E 圆角刻度。取值服从 M3E；Miuix 只贡献大容器的连续曲率，不改数值 -->
    <dimen name="md_shape_xs">4dp</dimen>
    <dimen name="md_shape_sm">8dp</dimen>
    <dimen name="md_shape_md">12dp</dimen>
    <dimen name="md_shape_lg">16dp</dimen>
    <dimen name="md_shape_lg_increased">20dp</dimen>
    <dimen name="md_shape_xl">28dp</dimen>
    <dimen name="md_shape_xl_increased">32dp</dimen>

    <!-- 字级：M3 基线里用到的十一档 -->
    <dimen name="md_type_display_small_size">36sp</dimen>
    <dimen name="md_type_display_small_line">44sp</dimen>
    <dimen name="md_type_headline_large_size">32sp</dimen>
    <dimen name="md_type_headline_large_line">40sp</dimen>
    <dimen name="md_type_headline_small_size">24sp</dimen>
    <dimen name="md_type_headline_small_line">32sp</dimen>
    <dimen name="md_type_title_large_size">22sp</dimen>
    <dimen name="md_type_title_large_line">28sp</dimen>
    <dimen name="md_type_title_medium_size">16sp</dimen>
    <dimen name="md_type_title_medium_line">24sp</dimen>
    <dimen name="md_type_title_small_size">14sp</dimen>
    <dimen name="md_type_title_small_line">20sp</dimen>
    <dimen name="md_type_body_large_size">16sp</dimen>
    <dimen name="md_type_body_large_line">24sp</dimen>
    <dimen name="md_type_body_medium_size">14sp</dimen>
    <dimen name="md_type_body_medium_line">20sp</dimen>
    <dimen name="md_type_body_small_size">12sp</dimen>
    <dimen name="md_type_body_small_line">16sp</dimen>
    <dimen name="md_type_label_large_size">14sp</dimen>
    <dimen name="md_type_label_large_line">20sp</dimen>
    <dimen name="md_type_label_medium_size">12sp</dimen>
    <dimen name="md_type_label_medium_line">16sp</dimen>

    <!-- 字重。中文在 400 与 500 之间差别小，标题族一律 500；
         M3E 的强调字级（状态标题、页面大标题）再升一档到 600 -->
    <integer name="md_weight_regular">400</integer>
    <integer name="md_weight_medium">500</integer>
    <integer name="md_weight_emphasized">600</integer>

    <!-- 尺寸：可触达下限与各组件的固定尺寸 -->
    <dimen name="md_size_touch_target">48dp</dimen>
    <dimen name="md_size_icon">24dp</dimen>
    <dimen name="md_size_icon_button">40dp</dimen>
    <dimen name="md_size_button">48dp</dimen>
    <dimen name="md_size_button_prominent">56dp</dimen>
    <dimen name="md_size_field">56dp</dimen>
    <dimen name="md_size_list_one_line">56dp</dimen>
    <dimen name="md_size_list_two_line">72dp</dimen>
    <dimen name="md_size_top_bar">64dp</dimen>
    <dimen name="md_size_switch_width">52dp</dimen>
    <dimen name="md_size_switch_height">32dp</dimen>
    <dimen name="md_size_switch_handle_off">16dp</dimen>
    <dimen name="md_size_switch_handle_on">24dp</dimen>
    <dimen name="md_size_switch_handle_pressed">28dp</dimen>
    <dimen name="md_size_loading">48dp</dimen>
    <dimen name="md_size_logo">40dp</dimen>
    <dimen name="md_size_border">1dp</dimen>
    <dimen name="md_size_focus_ring">2dp</dimen>
    <dimen name="md_size_content_max">640dp</dimen>
    <dimen name="md_size_dialog_min">280dp</dimen>
    <dimen name="md_size_dialog_max">560dp</dimen>
    <dimen name="md_size_snackbar_max">600dp</dimen>

    <!-- 动效：M3E 弹簧。空间弹簧驱动位置与形状，效果弹簧驱动颜色与透明度（无回弹）。
         阻尼比 ×100 存整数。页面与开关用标准方案（0.9），按钮按压的形状形变用表现力方案 -->
    <integer name="md_spring_damping_standard">90</integer>
    <integer name="md_spring_damping_expressive">60</integer>
    <integer name="md_spring_damping_effects">100</integer>
    <integer name="md_spring_spatial_fast">1400</integer>
    <integer name="md_spring_spatial_default">700</integer>
    <integer name="md_spring_expressive_fast">800</integer>
    <integer name="md_spring_effects_fast">3800</integer>
    <integer name="md_spring_effects_default">1600</integer>
    <!-- 页面级淡入淡出等非弹簧动画的时长上限（毫秒） -->
    <integer name="md_motion_medium">300</integer>

    <!-- 状态层：叠加在内容色上的不透明度（%） -->
    <integer name="md_state_hover_pct">8</integer>
    <integer name="md_state_pressed_pct">10</integer>
    <integer name="md_state_disabled_container_pct">12</integer>
    <integer name="md_state_disabled_content_pct">38</integer>
    <!-- 遮罩：弹窗背后的 scrim 不透明度（%） -->
    <integer name="md_scrim_pct">32</integer>

    <!-- 响应式：Android 窗口尺寸类别（dp），以及"按字号折算后的可用宽度"阈值。
         双栏与并排都按 可用宽度 ÷ 字号倍率 判断，所以 200% 字号会自动回到单栏 -->
    <integer name="md_bp_medium">600</integer>
    <integer name="md_bp_expanded">840</integer>
    <integer name="md_reflow_pane_min">360</integer>
    <integer name="md_reflow_pair_min">280</integer>
</resources>
