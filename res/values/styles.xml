<?xml version="1.0" encoding="utf-8"?>
<!--
  知弦主题（浅色）。取值全部指向 Design Tokens，不写字面值。
  界面全屏绘制（edge-to-edge）：系统栏透明，内容区自己按 WindowInsets 留出安全区。
  深色主题在 values-night，结构逐项对应。
-->
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorControlActivated">@color/md_primary</item>
        <item name="android:colorControlHighlight">@color/md_state_layer</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="android:textColorHint">@color/md_on_surface_variant</item>
        <item name="android:textColorHighlight">@color/md_primary_container</item>
    </style>
</resources>
